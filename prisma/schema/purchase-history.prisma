model PurchaseSuggestionHistory {
  id               Int                 @id @default(autoincrement())
  compraSugeridaId Int?                @map("compra_sugerida_id")
  compraSugerida   PurchaseSuggestion? @relation(fields: [compraSugeridaId], references: [id], onDelete: SetNull)
  usuarioId        Int                 @map("usuario_id")
  usuario          User                @relation(fields: [usuarioId], references: [id])
  accion           String // "CREATE", "UPDATE", "STATUS_CHANGE", "DELETE"
  cambios          Json?
  fechaCreacion    DateTime            @default(now()) @map("fecha_creacion")

  @@map("purchase_suggestion_history")
}
