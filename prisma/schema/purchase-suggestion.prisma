model PurchaseSuggestion {
  id                        Int                         @id @default(autoincrement())
  mc                        String                      @map("mc") @unique
  mca                       String                      @map("mca")
  mcap                      String?                     @map("mcap")
  codigoMaterial            Int                         @map("codigo_material")
  descripcionMaterial       String                      @map("descripcion_material")
  codProv                   String                      @map("cod_prov")
  proveedor                 String                      @map("proveedor")
  centroAbastecedor         String                      @map("centro_abastecedor")
  desDentro                 String?                     @map("des_dentro")
  porcCompra                Int?                        @map("porc_compra")
  almacen                   Int                         @map("almacen")
  categoria                 String?                     @map("categoria")
  ltReal                    Int                         @map("lt_real")
  factorLt                  Decimal                     @map("factor_lt") @db.Decimal(8, 4)
  frec                      Decimal                     @map("frec") @db.Decimal(8, 4)
  ump                       Int                         @map("ump")
  ums                       Int                         @map("ums")
  venta30DiasDiaDelDia      Decimal                     @map("venta_30_dias_dia_del_dia") @db.Decimal(14, 6)
  ventaFcDiaAjustada        Decimal                     @map("venta_fc_dia_ajustada") @db.Decimal(14, 6)
  porcDesviacionFcVsVenta   Decimal?                    @map("porc_desviacion_fc_vs_venta") @db.Decimal(10, 6)
  porcIncPlaneacionDemanda  Decimal?                    @map("porc_inc_planeacion_demanda") @db.Decimal(10, 6)
  aplica                    String?                     @map("aplica")
  pedidoPromedioDiaUmp      Int                         @map("pedido_promedio_dia_ump")
  tiendasAgotadas           Int?                        @map("tiendas_agotadas")
  tipologia                 Int?                        @map("tipologia")
  invTienda                 Decimal?                    @map("inv_tienda") @db.Decimal(14, 6)
  stockObjetivoTienda       Decimal?                    @map("stock_objetivo_tienda") @db.Decimal(14, 6)
  faltanteLlenadoTienda     Decimal?                    @map("faltante_llenado_tienda") @db.Decimal(14, 6)
  diasInvTienda             Decimal?                    @map("dias_inv_tienda") @db.Decimal(10, 6)
  inventarioFisico          Decimal?                    @map("inventario_fisico") @db.Decimal(14, 6)
  inventarioEnTransito      Int?                        @map("inventario_en_transito")
  diasInvALaFecha           Decimal?                    @map("dias_inv_a_la_fecha") @db.Decimal(10, 6)
  diasInvFisicoTransito     Decimal?                    @map("dias_inv_fisico_transito") @db.Decimal(10, 6)
  zonarojaPura              Decimal?                    @map("zonaroja_pura") @db.Decimal(14, 6)
  zonaroja                  Decimal?                    @map("zonaroja") @db.Decimal(14, 6)
  zonaamarilla              Decimal?                    @map("zonaamarilla") @db.Decimal(14, 6)
  zonaverde                 Decimal?                    @map("zonaverde") @db.Decimal(14, 6)
  tamBufferPuroUmp          Decimal?                    @map("tam_buffer_puro_ump") @db.Decimal(14, 6)
  tamBufferUmp              Decimal?                    @map("tam_buffer_ump") @db.Decimal(14, 6)
  demandaCalificada         Decimal?                    @map("demanda_calificada") @db.Decimal(14, 6)
  activoLunes               Boolean                     @map("activo_lunes")
  activoMartes              Boolean                     @map("activo_martes")
  activoMiercoles           Boolean                     @map("activo_miercoles")
  activoJueves              Boolean                     @map("activo_jueves")
  activoViernes             Boolean                     @map("activo_viernes")
  activoSabado              Boolean                     @map("activo_sabado")
  activoDomingo             Boolean                     @map("activo_domingo")
  pedidoHoy                 Int                         @map("pedido_hoy")
  pedidoF1                  Int?                        @map("pedido_f1")
  pedidoF2                  Int?                        @map("pedido_f2")
  pedidoF3                  Int?                        @map("pedido_f3")
  pedidoF4                  Int?                        @map("pedido_f4")
  pedidoF5                  Int?                        @map("pedido_f5")
  pedidoF6                  Int?                        @map("pedido_f6")
  estimadoParaTopeBuffer    Int?                        @map("estimado_para_tope_buffer")
  cantidadDefinitivaOcHoy   Decimal?                    @map("cantidad_definitiva_oc_hoy") @db.Decimal(14, 4)
  cantidadDefinitivaOcF1    Decimal?                    @map("cantidad_definitiva_oc_f1") @db.Decimal(14, 4)
  cantidadDefinitivaOcF2    Decimal?                    @map("cantidad_definitiva_oc_f2") @db.Decimal(14, 4)
  cantidadDefinitivaOcF3    Decimal?                    @map("cantidad_definitiva_oc_f3") @db.Decimal(14, 4)
  factorVariabilidadVenta   Decimal?                    @map("factor_variabilidad_venta") @db.Decimal(8, 4)
  diasMinimoInv             Decimal?                    @map("dias_minimo_inv") @db.Decimal(10, 4)
  diasPromedioInv           Decimal?                    @map("dias_promedio_inv") @db.Decimal(10, 4)
  diasMaximoInv             Decimal?                    @map("dias_maximo_inv") @db.Decimal(10, 4)
  diasInvCantidadDefinitiva Decimal?                    @map("dias_inv_cantidad_definitiva") @db.Decimal(10, 6)
  diasInvCdF1               Decimal?                    @map("dias_inv_cd_f1") @db.Decimal(10, 6)
  diasInvCdF2               Decimal?                    @map("dias_inv_cd_f2") @db.Decimal(10, 6)
  diasInvCdF3               Decimal?                    @map("dias_inv_cd_f3") @db.Decimal(10, 6)
  diaDePedido               String?                     @map("dia_de_pedido")
  diaDeLlegada              String?                     @map("dia_de_llegada")
  fechaEstimadaEntrega      DateTime?                   @map("fecha_estimada_entrega")
  nomDiaEntrega             String?                     @map("nom_dia_entrega")
  fechaEntregaF1            DateTime?                   @map("fecha_entrega_f1")
  fechaEntregaF2            DateTime?                   @map("fecha_entrega_f2")
  fechaEntregaF3            DateTime?                   @map("fecha_entrega_f3")
  alertaStock               String?                     @map("alerta_stock")
  vidaUtilMinDiasReciboCedi Int?                        @map("vida_util_min_dias_recibo_cedi")
  alertaVidaUtil            String?                     @map("alerta_vida_util")
  crossDock                 Boolean?                    @map("cross_dock")
  moq                       Int?                        @map("moq")
  subcategoria              String?                     @map("subcategoria")
  temperaturaAlmacenamiento String?                     @map("temperatura_almacenamiento")
  responsableDeCompra       String?                     @map("responsable_de_compra")
  category                  String?                     @map("category")
  multiploDeCompra          Int?                        @map("multiplo_de_compra")
  estado                    String?                     @map("estado")
  fechaCreacion             DateTime                    @default(now()) @map("fecha_creacion")
  fechaActualizacion        DateTime                    @default(now()) @map("fecha_actualizacion")
  historial                 PurchaseSuggestionHistory[]
  estadoCompraSugerida      PurchaseSuggestionStatus?   @relation(fields: [estado], references: [codigo])

  @@map("purchase_suggestions")
  @@index([codigoMaterial])
  @@index([centroAbastecedor])
  @@index([estado])
}
